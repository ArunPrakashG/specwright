  "policies": [
    {
      "id": "shipping",
      "title": "Shipping",
      "body": "We ship from Bristol within three working days. Flat rate per market, free over 120 in your currency."
    },
    {
      "id": "returns",
      "title": "Returns",
      "body": "Return unused pieces within 30 days for a full refund. Breakages in transit are replaced free."
    },
    {
      "id": "privacy",
      "title": "Privacy",
      "body": "We keep your name, address and order history to fulfil orders. We never sell your data."
    },
    {
      "id": "accessibility",
      "title": "Accessibility",
      "body": "This store aims to meet WCAG 2.2 AA. Tell us about any barrier at hello@haleandfield.com."
