          }
        },
        {
          "id": "hero",
          "type": "hero",
          "settings": {
            "heading": {
              "en": "Stoneware, made slowly.",
              "de": "Steinzeug, langsam gemacht.",
              "fr": "Du grès, fait lentement."
            },
            "lead": "Small-batch tableware, thrown and glazed in our Bristol studio. Shipped to the UK, EU and US.",
            "button": {
              "label": "Shop the collection",
              "href": "/shop"
            },
            "image": {
              "src": "images/hero-bowls.svg",
              "alt": "",
              "background": "tile-1"
            }
          }
        },
        {
          "id": "featured",
          "type": "product-grid",
          "settings": {
            "heading": "The everyday set",
            "category": "everyday",
            "limit": 3,
            "link": {
              "label": "View all",
              "href": "/shop"
            }
          }
        },
        {
          "id": "story",
          "type": "media-text",
          "settings": {
            "heading": "Fired twice, used daily.",
            "body": "Every piece is thrown by hand, bisque fired, glazed, then fired again. Dishwasher safe, made to be used.",
            "link": {
              "label": "Read our story",
              "href": "/about"
            },
            "linkColor": "#9A8F7E",
            "image": {
              "src": "images/kiln-stack.svg",
              "alt": "",
              "background": "tile-3"
            }
          }
        },
        {
          "id": "newsletter",
          "type": "newsletter",
          "settings": {
            "heading": "Kiln notes, once a month.",
            "list": "kiln-notes",
            "button": "Subscribe"
          }
        },
        {
          "id": "footer",
          "type": "footer",
          "settings": {
            "address": "Hale & Field Studio, Bristol",
            "links": [
              {
                "label": "Shipping",
                "href": "/policies/shipping"
              },
              {
                "label": "Returns",
                "href": "/policies/returns"
              },
              {
                "label": "Privacy",
                "href": "/policies/privacy"
              },
              {
                "label": "Accessibility",
                "href": "/policies/accessibility"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "about",
      "title": "About",
      "path": "/about",
      "sections": [
        {
          "id": "intro",
          "type": "rich-text",
          "settings": {
            "heading": "Our story",
            "body": "Hale & Field is two potters and one kiln in Bristol. We make a small range of tableware and keep making it, so a broken plate can always be replaced.\n\nEverything is thrown on the wheel, trimmed by hand and fired twice."
          }
        },
        {
          "id": "studio",
          "type": "media-text",
          "settings": {
            "heading": "Made to be used.",
            "body": "Our glazes are food safe and lead free. Every piece goes in the dishwasher and the microwave.",
            "image": {
              "src": "images/kiln-stack.svg",
              "alt": "Plates stacked in the kiln",
              "background": "tile-2"
            }
          }
        }
      ]
    },
    {
      "id": "journal",
      "title": "Journal",
      "path": "/journal",
      "sections": [
        {
          "id": "intro",
          "type": "rich-text",
          "settings": {
            "heading": "Journal",
            "body": "Notes from the studio: new glazes, kiln days and what we are making next. Subscribe to Kiln notes to get them by email."
          }
        }
      ]
    }
  ],
