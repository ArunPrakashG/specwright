# Postgres for the dashboard and build worker
DATABASE_URL=postgres://specwright:specwright@localhost:5433/specwright
# Optional: bring your own key to draft specs from a brief and triage review comments
ANTHROPIC_API_KEY=
# Where builds write themes, screenshots and reports
SPECWRIGHT_DATA_DIR=./.specwright
# Required when the dashboard is reachable by anyone but you: signs in the agency side.
# Client review links (/r/...) stay public. Generate with: openssl rand -hex 24
SPECWRIGHT_ADMIN_TOKEN=
# Optional: "Continue with Google" on the sign-in page. Create a Web OAuth client with the redirect URI
# <your dashboard URL>/api/v1/auth/google/callback. Only addresses listed here can sign in
# (comma-separated; "@example.com" allows a whole domain).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SPECWRIGHT_ADMIN_EMAILS=
# The dashboard's public URL, used for the Google redirect URI (e.g. https://specwright.example.com)
SPECWRIGHT_PUBLIC_URL=
